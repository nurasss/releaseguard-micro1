# path: .env.example
# ReleaseGuard Environment Configuration Example
# Copy to .env and configure local parameters

# LLM Provider: "google" or "xai"
RG_LLM_PROVIDER=google

# Google default. For xAI set RG_MODEL_ID=grok-4.6.
RG_MODEL_ID=gemini-2.5-flash

# Provider API Key (never commit real keys)
GEMINI_API_KEY=
XAI_API_KEY=

# GitHub Token for live repository audits (optional, increases rate limits)
GITHUB_TOKEN=

# Minimum interval between requests in milliseconds (6500ms recommended to avoid 429 quota spikes on free tier)
RG_MIN_REQUEST_INTERVAL_MS=6500
# xAI uses a separate default so Gemini's free-tier throttle is not inherited.
RG_XAI_MIN_REQUEST_INTERVAL_MS=0
RG_XAI_REASONING_EFFORT=low

# Base directories
RG_DATA_DIR=./runs
RG_DB_PATH=./runs/releaseguard.sqlite3
RG_TRAJECTORIES_DIR=./trajectories
RG_ARTIFACTS_DIR=./artifacts

# Prompt and system versions
RG_PROMPT_VERSION=final-v2
RG_SYSTEM_VERSION=0.1.0

# Execution constraints
RG_AUDIT_DEADLINE_S=300
RG_REQUEST_TIMEOUT_S=120
RG_MAX_RETRIES=4
