        "content": "\"\"\"Record merge utilities.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef merge_records(source: dict, target: dict) -> dict:\n    merged = dict(target)\n    merged.update(source)\n    return merged\n\n\ndef diff_keys(source: dict, target: dict) -> set:\n    return set(source) - set(target)",
