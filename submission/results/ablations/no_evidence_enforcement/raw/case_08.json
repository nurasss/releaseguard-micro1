      "summary": "Read file scripts/generate_openapi.py (lines 1-36)",
      "payload": {
        "path": "scripts/generate_openapi.py",
        "start_line": 1,
        "end_line": 36,
        "total_lines": 36,
        "content": "\"\"\"Generator script to produce docs/openapi.json from src/api/routes.py.\"\"\"\n\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom src.api.routes import ROUTES\n\n\ndef generate():\n    source_path = Path(\"src/api/routes.py\")\n    source_hash = hashlib.sha256(source_path.read_bytes()).hexdigest()\n    paths = {}\n    for r in ROUTES:\n        path = r[\"path\"]\n        method = r[\"method\"].lower()\n        if path not in paths:\n            paths[path] = {}\n        paths[path][method] = {\n            \"summary\": r[\"summary\"],\n            \"responses\": {\"200\": {\"description\": \"OK\"}},\n        }\n\n    spec = {\n        \"openapi\": \"3.0.0\",\n        \"info\": {\n            \"title\": \"User API\",\n            \"version\": \"1.5.0\",\n            \"description\": f\"Generated by scripts/generate_openapi.py from src/api/routes.py (source_hash: {source_hash})\",\n        },\n        \"paths\": paths,\n    }\n    Path(\"docs/openapi.json\").write_text(json.dumps(spec, indent=2), encoding=\"utf-8\")\n\n\nif __name__ == \"__main__\":\n    generate()",
        "truncated": false,
        "content_hash": "sha256:f4c38eeca2edf74e565c3764bb6c6a696cb74f8a6e9b72ad6649a7a23a61da10"
