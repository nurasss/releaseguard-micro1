      "payload": {
        "path": "src/notifier/config.py",
        "start_line": 1,
        "end_line": 14,
        "total_lines": 14,
        "content": "\"\"\"Startup configuration for the notifier service.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\n\n# Required: the SMTP relay host. There is no default because sending mail\n# without a configured relay is not a safe fallback. It is not documented\n# in README.md or .env.example.\nSMTP_HOST = os.environ[\"SMTP_HOST\"]\n\nSMTP_PORT = int(os.environ.get(\"SMTP_PORT\", \"587\"))\nLOG_LEVEL = os.environ.get(\"LOG_LEVEL\", \"INFO\")\nAPI_TIMEOUT_SECONDS = int(os.environ.get(\"API_TIMEOUT_SECONDS\", \"30\"))",
        "truncated": false,
        "content_hash": "sha256:7abffc9a0a7cfe268e0ee83d23250592ab2a1ee69c8e45596c9e7b91f704a17f"
