  "commit_sha": "dd6f7a7abcfd940346d5166ae3966f8a962e3683",
  "mode": "baseline",
  "decision": "NO-GO",
  "executive_summary": "Tag v2.1.0 and GitHub release exist and CI reported success, but the package is still versioned 2.0.3, changelog features (PKCE, multi-tenant verification, clock-skew fixes) are not present in the code, JWT handling is a mock unsigned token, and AUTH_SECRET_KEY defaults to an insecure hardcoded value. This is not ready to ship as an auth microservice.",
  "findings": [
    {
      "id": "F-001",
      "audit_run_id": "aud_87b990a260fd",
      "category": "release_metadata",
      "title": "Version mismatch between tag and package",
      "severity": "critical",
      "claim": "Release tag v2.1.0 does not match project version 2.0.3 in pyproject.toml and src/auth_service/__init__.py.",
      "confidence": 0.99,
      "evidence_ids": [
        "E-001",
        "E-009",
        "E-013"
      ],
      "recommended_action": "Bump version to 2.1.0 in pyproject.toml and __version__ and re-tag only after code matches the release notes.",
      "verification_status": "pending",
      "origin": "baseline"
    },
    {
      "id": "F-002",
      "audit_run_id": "aud_87b990a260fd",
      "category": "docs",
      "title": "Changelog claims unimplemented features",
      "severity": "high",
      "claim": "CHANGELOG 2.1.0 lists OAuth2 PKCE, multi-tenant token verification, and clock-skew expiration fixes, but the source only has a mock JWT helper and a stub run() entrypoint.",
      "confidence": 0.95,
      "evidence_ids": [
        "E-008",
        "E-011",
        "E-012"
      ],
      "recommended_action": "Either implement the documented features or rewrite the changelog to match actual code before release.",
      "verification_status": "pending",
      "origin": "baseline"
    },
    {
      "id": "F-003",
      "audit_run_id": "aud_87b990a260fd",
      "category": "security",
      "title": "Insecure default secret key",
      "severity": "critical",
      "claim": "config.py falls back to AUTH_SECRET_KEY default-insecure-secret, which is unsafe for an authentication service.",
      "confidence": 0.98,
      "evidence_ids": [
        "E-010"
      ],
      "recommended_action": "Require AUTH_SECRET_KEY at startup with no default; fail closed if unset.",
      "verification_status": "pending",
      "origin": "baseline"
    },
    {
      "id": "F-004",
      "audit_run_id": "aud_87b990a260fd",
      "category": "security",
      "title": "Tokens are unsigned mocks",
      "severity": "critical",
      "claim": "create_mock_jwt emits HS256 headers with a literal mock_sig and no cryptographic signature or verification.",
      "confidence": 0.99,
      "evidence_ids": [
        "E-011",
        "E-014"
      ],
      "recommended_action": "Replace mock JWT construction with a real signed JWT library and add verification tests before any production release.",
      "verification_status": "pending",
      "origin": "baseline"
    },
    {
      "id": "F-005",
      "audit_run_id": "aud_87b990a260fd",
      "category": "ci",
      "title": "CI does not install dependencies",
      "severity": "high",
      "claim": "ci.yml runs pytest without pip install of project extras; pydantic/fastapi are declared but not installed in CI, and no test/build artifacts were available.",
      "confidence": 0.85,
      "evidence_ids": [
        "E-015",
        "E-005",
        "E-006",
        "E-009"
      ],
      "recommended_action": "Install the package and pytest in CI, pin a test extra, and publish test/build reports.",
      "verification_status": "pending",
      "origin": "baseline"
    },
    {
      "id": "F-006",
      "audit_run_id": "aud_87b990a260fd",
      "category": "tests",
      "title": "Tests only cover mock token format",
      "severity": "medium",
      "claim": "The only test asserts eyJ prefix and mock_sig; there is no coverage of auth, expiry, or OAuth2.",
      "confidence": 0.9,
      "evidence_ids": [
        "E-014",
        "E-002"
      ],
      "recommended_action": "Add tests for real token issue/verify, secret handling, and claimed 2.1.0 behaviors.",
      "verification_status": "pending",
      "origin": "baseline"
    },
    {
      "id": "F-007",
      "audit_run_id": "aud_87b990a260fd",
      "category": "docs",
      "title": "README is insufficient for an auth service",
      "severity": "low",
      "claim": "README is a one-line description with no run, config, or security guidance.",
      "confidence": 0.9,
      "evidence_ids": [
        "E-007"
      ],
      "recommended_action": "Document configuration, threat model, and how to run/deploy before calling the release complete.",
      "verification_status": "pending",
