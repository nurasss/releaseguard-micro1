  "findings": [
    {
      "id": "F-001",
      "audit_run_id": "aud_ff2e968c6330",
      "category": "ci",
      "title": "Release workflow does not trigger on release/v2.4.0",
      "severity": "high",
      "claim": "Observed: .github/workflows/release.yml push trigger is restricted to branch main only and does not include release/v2.4.0. Deterministic check DC-03 failed for the same reason. Inference: the publish job (python -m build / twine path) is not configured to run for this release ref, so release artifacts are not verified by that workflow on this ref. Latest recorded CI success (DC-04 / E-011) is the CI workflow, not Release.",
      "confidence": 0.95,
      "evidence_ids": [
        "E-003",
        "E-015",
        "E-004",
        "E-011"
      ],
      "recommended_action": "Extend the Release workflow push trigger to include release/** (or tags matching v*) so publish/build runs on the audited release ref, or document an alternate required publish path.",
      "verification_status": "confirmed",
      "origin": "analyzer"
    },
    {
      "id": "F-002",
      "audit_run_id": "aud_ff2e968c6330",
      "category": "tests",
      "title": "CI test job does not execute the test suite",
      "severity": "high",
      "claim": "Observed: tests/test_transforms.py defines test_normalize_records, and DC-01 found 1 test file. Observed: .github/workflows/ci.yml test step is only `echo \"Running test suite\"` and does not invoke pytest or any test runner. No test execution report exists (DC-01, E-012). Inference: tests are not actually verified in CI despite a successful CI run conclusion.",
      "confidence": 0.93,
      "evidence_ids": [
        "E-001",
        "E-014",
        "E-012",
        "E-020"
      ],
      "recommended_action": "Replace the echo step with a real test command (e.g. pytest) and retain JUnit/coverage reports so CI success reflects suite results.",
      "verification_status": "confirmed",
      "origin": "analyzer"
    },
    {
      "id": "F-003",
      "audit_run_id": "aud_ff2e968c6330",
      "category": "build",
      "title": "No build report and Release publish not run on this ref",
      "severity": "medium",
      "claim": "Observed: DC-07 found no declared Makefile/package.json build script; pyproject.toml has a setuptools build-system. Observed: release.yml would run python -m build but only on main. No build report is available (E-013). There is no GitHub Releases entry despite tag v2.4.0 (E-008). This is a reproducibility/artifact-verification risk, not a demonstrated failed build.",
      "confidence": 0.85,
      "evidence_ids": [
        "E-013",
        "E-015",
        "E-016",
        "E-008"
      ],
      "recommended_action": "Run and archive `python -m build` on the release ref (or tag) and attach artifacts; align GitHub Releases with tag v2.4.0 if publishing is intended.",
      "verification_status": "pending",
      "origin": "analyzer"
